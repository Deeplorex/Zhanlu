{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhanlu",
  "version": "0.1.0",
  "identifier": "org.zhanlu.app",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Zhanlu.PDF", "description": "PDF 文档", "role": "Viewer", "mimeType": "application/pdf" }
    ],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "../../../engine/build/dist/zhanlu-engine": "engine/",
      "../../../apps/web/dist": "web-dist/"
    }
  }
}
